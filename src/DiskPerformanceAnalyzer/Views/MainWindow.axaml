<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DiskPerformanceAnalyzer.ViewModels"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="DiskPerformanceAnalyzer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Disk Performance Analyzer"
        Icon="avares://DiskPerformanceAnalyzer/Assets/app.ico"
        Width="1280" Height="760" MinWidth="1000" MinHeight="640"
        Background="#151921">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!-- Fluent-style glyphs as geometry so no icon font is required. -->
        <StreamGeometry x:Key="IconFolder">M2 5.5A2.5 2.5 0 0 1 4.5 3h3.6c.6 0 1.2.2 1.6.6L11.4 5H15.5A2.5 2.5 0 0 1 18 7.5v7A2.5 2.5 0 0 1 15.5 17h-11A2.5 2.5 0 0 1 2 14.5v-9Zm2.5-1A1.5 1.5 0 0 0 3 5.5V7h14v.5A1.5 1.5 0 0 0 15.5 6h-4.3c-.4 0-.8-.2-1.1-.4L8.9 4.3a1.5 1.5 0 0 0-.8-.3H4.5ZM3 8v6.5A1.5 1.5 0 0 0 4.5 16h11a1.5 1.5 0 0 0 1.5-1.5V8H3Z</StreamGeometry>
        <StreamGeometry x:Key="IconShare">M13 3.5a2.5 2.5 0 1 1 .6 1.6L8.1 8.4a2.5 2.5 0 0 1 0 3.2l5.5 3.3a2.5 2.5 0 1 1-.5.9l-5.6-3.4a2.5 2.5 0 1 1 0-4.8l5.6-3.4A2.5 2.5 0 0 1 13 3.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconColumns">M3 4.5A1.5 1.5 0 0 1 4.5 3h11A1.5 1.5 0 0 1 17 4.5v11a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 15.5v-11ZM4 8v7.5c0 .3.2.5.5.5H7V8H4Zm4 0v8h4V8H8Zm5 0v8h2.5c.3 0 .5-.2.5-.5V8h-3Z</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M5 3h3v14H5V3Zm7 0h3v14h-3V3Z</StreamGeometry>
        <StreamGeometry x:Key="IconPlay">M6 3.5v13l10-6.5-10-6.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M8.5 3a5.5 5.5 0 0 1 4.4 8.8l4.2 4.2-1.1 1.1-4.2-4.2A5.5 5.5 0 1 1 8.5 3Zm0 1.5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronRight">M7.3 4.3a1 1 0 0 1 1.4 0l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 0 1-1.4-1.4L11.6 10 7.3 5.7a1 1 0 0 1 0-1.4Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronDown">M4.3 7.3a1 1 0 0 1 1.4 0L10 11.6l4.3-4.3a1 1 0 1 1 1.4 1.4l-5 5a1 1 0 0 1-1.4 0l-5-5a1 1 0 0 1 0-1.4Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#8B93A1" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- Tabular figures: every digit has the same width, so live numbers never shift their neighbours. -->
        <Style Selector="TextBlock.tnum">
            <Setter Property="FontFeatures">
                <FontFeatureCollection>
                    <FontFeature Tag="tnum" />
                </FontFeatureCollection>
            </Setter>
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        </Style>
        <Style Selector="TextBlock.read-req">
            <Setter Property="Foreground" Value="#9CC8FF" />
        </Style>
        <Style Selector="TextBlock.write-req">
            <Setter Property="Foreground" Value="#5C9BE8" />
        </Style>
        <Style Selector="TextBlock.read-data">
            <Setter Property="Foreground" Value="#8EE3B4" />
        </Style>
        <Style Selector="TextBlock.write-data">
            <Setter Property="Foreground" Value="#3FAF76" />
        </Style>
        <Style Selector="Button.seg">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B7BEC9" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.seg.active">
            <Setter Property="Background" Value="#3B8EEA" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.mini">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="#2A313D" />
            <Setter Property="Foreground" Value="#D8DEE9" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Icon-only buttons inside table cells and toolbars -->
        <Style Selector="Button.icon">
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8B93A1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A313D" />
            <Setter Property="TextElement.Foreground" Value="#E6EAF0" />
        </Style>
        <Style Selector="Button.icon:disabled">
            <Setter Property="Opacity" Value="0.25" />
        </Style>
        <Style Selector="Button.chartctl">
            <Setter Property="Foreground" Value="#5B6472" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="Button.chartctl PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.icon PathIcon">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
        </Style>
        <Style Selector="Button.chevron PathIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <!-- Column header buttons: plain text, click sorts -->
        <Style Selector="Button.colhead">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8B93A1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.colhead:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="#E6EAF0" />
        </Style>
        <Style Selector="Button.colhead.num">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <!-- The SHARE header holds one chip per metric; the active chip is the sort key and the primary bar. -->
        <Style Selector="Button.colhead.chip">
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#242A35" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Selector="Button.colhead.chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2F3745" />
        </Style>
        <Style Selector="Button.colhead.chip.req.active">
            <Setter Property="Background" Value="#2F6FC7" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.colhead.chip.data.active">
            <Setter Property="Background" Value="#2E8F5E" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.colhead.chip.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ProgressBar.share">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Background" Value="#2A313D" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ProgressBar.share.req">
            <Setter Property="Foreground" Value="#3B8EEA" />
        </Style>
        <Style Selector="ProgressBar.share.data">
            <Setter Property="Foreground" Value="#3FAF76" />
        </Style>
        <Style Selector="ProgressBar.share.dim">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="ListBox.disks ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ListBox.disks ListBoxItem:selected /template/ ContentPresenter, ListBox.disks ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.disks ListBoxItem Border.card">
            <Setter Property="Background" Value="#1D222C" />
            <Setter Property="BorderBrush" Value="#2A313D" />
        </Style>
        <Style Selector="ListBox.disks ListBoxItem:pointerover Border.card">
            <Setter Property="BorderBrush" Value="#3E4756" />
        </Style>
        <Style Selector="ListBox.disks ListBoxItem:selected Border.card">
            <Setter Property="Background" Value="#22304A" />
            <Setter Property="BorderBrush" Value="#3B8EEA" />
        </Style>
        <!-- DataGrid: dark, dense, resizable columns -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#232933" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="CanUserReorderColumns" Value="True" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="RowDetailsVisibilityMode" Value="Collapsed" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#181C25" />
            <Setter Property="Foreground" Value="#8B93A1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="SeparatorBrush" Value="#2A313D" />
            <Setter Property="AreSeparatorsVisible" Value="True" />
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#1D222C" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#22304A" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="300,*">

        <!-- Left rail: one card per physical disk -->
        <Border Grid.Column="0" Background="#12151C" BorderBrush="#232933" BorderThickness="0,0,1,0" Padding="20,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20" Spacing="2">
                    <TextBlock Classes="h1" Text="Disks" />
                    <TextBlock Classes="muted" FontSize="12" Text="Requests and data per physical disk" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="2">
                    <Border IsVisible="{Binding HasNotice}" Background="#2A2410" BorderBrush="#5C4A14" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                        <TextBlock FontSize="11" Foreground="#E0B84A" TextWrapping="Wrap" Text="{Binding Notice}" />
                    </Border>
                    <TextBlock Classes="muted" FontSize="11" Text="{Binding SelfLoadText}" ToolTip.Tip="The monitor's own disk footprint. The ETW session is real-time only (no trace file) and nothing is logged, so this should stay at zero." />
                    <TextBlock Classes="muted" FontSize="11" Text="{Binding StatusText}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}"
                         Classes="disks" Background="Transparent" BorderThickness="0" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiskViewModel">
                            <Border Classes="card" CornerRadius="12" BorderThickness="1" Padding="16,14" Cursor="Hand" ToolTip.Tip="{Binding CardTooltip}">
                                <!-- Fixed column widths + tabular figures: values change, nothing moves. -->
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,48" ColumnDefinitions="16,72,16,72,*" RowSpacing="2">
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="8" Margin="0,2,0,2">
                                        <TextBlock Classes="tnum" Text="{Binding IopsText}" FontSize="30" FontWeight="Light" MinWidth="64" />
                                        <TextBlock Classes="muted" FontSize="12" Text="req/s" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="read-req" FontSize="11" Text="&#x2193;" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="read-req tnum" FontSize="11" Text="{Binding ReadOpsText}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Classes="write-req" FontSize="11" Text="&#x2191;" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Classes="write-req tnum" FontSize="11" Text="{Binding WriteOpsText}" />
                                    <TextBlock Grid.Row="2" Grid.Column="4" Classes="muted" FontSize="11" Text="req/s" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="read-data" FontSize="11" Text="&#x2193;" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="read-data tnum" FontSize="11" Text="{Binding ReadRateText}" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Classes="write-data" FontSize="11" Text="&#x2191;" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Classes="write-data tnum" FontSize="11" Text="{Binding WriteRateText}" />
                                    <TextBlock Grid.Row="3" Grid.Column="4" Classes="muted" FontSize="11" Text="data" />

                                    <lvc:CartesianChart Grid.Row="4" Grid.ColumnSpan="5" Margin="-6,6,-6,-6"
                                                        Series="{Binding SparkSeries}"
                                                        XAxes="{Binding SparkXAxes}"
                                                        YAxes="{Binding SparkYAxes}"
                                                        TooltipPosition="Hidden"
                                                        LegendPosition="Hidden"
                                                        ZoomMode="None"
                                                        AnimationsSpeed="0:0:0"
                                                        EasingFunction="{x:Null}"
                                                        IsHitTestVisible="False"
                                                        Background="Transparent" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right: one filter bar drives chart and table -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,2*,Auto,3*" Margin="28,24,28,24">

            <!-- Title + frozen pill -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border IsVisible="{Binding IsFrozen}" Background="#3A2F14" BorderBrush="#F2B94C" BorderThickness="1" CornerRadius="14" Padding="12,4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#x23F8;" VerticalAlignment="Center" Foreground="#F2B94C" />
                            <TextBlock Text="{Binding FrozenText}" VerticalAlignment="Center" Foreground="#F2B94C" FontWeight="SemiBold" />
                            <Button Command="{Binding GoLiveCommand}" Content="Live" Classes="mini" Background="#F2B94C" Foreground="#1B1F27" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="h1" Text="{Binding SelectedDiskTitle}" />
                    <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
                        <Run Text="Showing " /><Run Text="{Binding FilterDescription}" FontWeight="SemiBold" Foreground="#B7BEC9" /><Run Text=". Type to filter, click a row to isolate it (click again to release), click the chart to freeze a second." />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Filter bar: one prominent input drives chart and table -->
            <Border Grid.Row="1" Margin="0,0,0,16" Background="#1D222C" BorderBrush="#3B8EEA" BorderThickness="1" CornerRadius="10" Padding="16,0" Height="46">
                <DockPanel>
                    <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconSearch}" Width="18" Height="18" Foreground="#3B8EEA" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Classes="mini" Content="Clear filter" Command="{Binding ClearFilterCommand}" IsVisible="{Binding HasFilter}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding FilterText}" Watermark="Filter by process name or file path — chart and table follow" FontSize="14"
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Chart: data as areas (left axis), requests as lines (right axis) -->
            <Border Grid.Row="2" Background="#1D222C" CornerRadius="12" Padding="12" MinHeight="180">
                <Grid>
                    <lvc:CartesianChart x:Name="Chart"
                                        Series="{Binding Series}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        LegendPosition="Top"
                                        TooltipPosition="Top"
                                        ZoomMode="None"
                                        AnimationsSpeed="0:0:0"
                                        EasingFunction="{x:Null}"
                                        Cursor="Cross"
                                        Background="Transparent" />
                    <TextBlock IsVisible="{Binding !HasSelection}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Waiting for the first disk sample..." />
                    <Button Classes="icon chartctl" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                            Command="{Binding TogglePauseCommand}" ToolTip.Tip="{Binding PauseButtonText}">
                        <Panel>
                            <PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding !IsPaused}" />
                            <PathIcon Data="{StaticResource IconPlay}" IsVisible="{Binding IsPaused}" />
                        </Panel>
                    </Button>
                    <Border IsVisible="{Binding IsPaused}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                            Background="#2A313D" CornerRadius="10" Padding="10,2">
                        <TextBlock Classes="muted" FontSize="11" Text="Paused — chart and table are frozen, sampling continues" />
                    </Border>
                </Grid>
            </Border>

            <!-- Table toolbar: caption · window · columns -->
            <DockPanel Grid.Row="3" Margin="0,20,0,10">
                <Button DockPanel.Dock="Right" Classes="icon" Margin="10,0,0,0" ToolTip.Tip="Choose visible columns">
                    <PathIcon Data="{StaticResource IconColumns}" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="6" MinWidth="200">
                                <TextBlock Classes="muted" FontSize="11" Text="COLUMNS" Margin="0,0,0,4" />
                                <CheckBox Content="PID" IsChecked="{Binding ShowPid}" />
                                <CheckBox Content="&#x2193; Read (data)" IsChecked="{Binding ShowRead}" />
                                <CheckBox Content="&#x2191; Write (data)" IsChecked="{Binding ShowWrite}" />
                                <CheckBox Content="Requests" IsChecked="{Binding ShowRequests}" />
                                <CheckBox Content="Share" IsChecked="{Binding ShowShare}" />
                                <CheckBox Content="Top file" IsChecked="{Binding ShowTopFile}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Border DockPanel.Dock="Right" Background="#1D222C" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="seg" Classes.active="{Binding IsWindow5}" Content="5 s" Command="{Binding SelectWindowCommand}" CommandParameter="5" />
                        <Button Classes="seg" Classes.active="{Binding IsWindow60}" Content="1 min" Command="{Binding SelectWindowCommand}" CommandParameter="60" />
                        <Button Classes="seg" Classes.active="{Binding IsWindow300}" Content="5 min" Command="{Binding SelectWindowCommand}" CommandParameter="300" />
                        <Button Classes="seg" Classes.active="{Binding IsCumulative}" Content="&#x3A3; since start" Command="{Binding SelectWindowCommand}" CommandParameter="all" />
                    </StackPanel>
                </Border>
                <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="Processes on this disk, " /><Run Text="{Binding WindowLabel}" /><Run Text=". Bars = share of requests (blue) / data (green), hover for numbers. &#x25B8; = folders." />
                </TextBlock>
            </DockPanel>

            <!-- Process table -->
            <Border Grid.Row="4" Background="#1D222C" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="ProcessGrid" ItemsSource="{Binding Processes}" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate x:DataType="vm:ProcessRowViewModel">
                                <Border Background="#181C25" BorderBrush="#232933" BorderThickness="0,0,0,1" Padding="40,8,16,10">
                                    <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="60,*,150,70,80" Margin="0,0,0,4">
                                            <TextBlock Grid.Column="1" Classes="muted" FontSize="10" FontWeight="SemiBold" Text="WHERE THIS PROCESS IS BUSY — top folders, rolled up to the most specific level that fits" />
                                            <TextBlock Grid.Column="2" Classes="muted" FontSize="10" FontWeight="SemiBold" Text="SHARE OF PROCESS" />
                                            <TextBlock Grid.Column="3" Classes="muted num" FontSize="10" FontWeight="SemiBold" Text="REQUESTS" />
                                            <TextBlock Grid.Column="4" Classes="muted num" FontSize="10" FontWeight="SemiBold" Text="DATA" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Breakdown}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FolderRowViewModel">
                                                    <Grid ColumnDefinitions="60,*,150,70,80" Height="26">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                                            <Button Classes="icon" PointerPressed="OnCellButtonPressed" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open this folder in Explorer">
                                                                <PathIcon Data="{StaticResource IconFolder}" />
                                                            </Button>
                                                            <Button Classes="icon" PointerPressed="OnCellButtonPressed" Command="{Binding CopyPathCommand}" ToolTip.Tip="Copy the folder path">
                                                                <PathIcon Data="{StaticResource IconShare}" />
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding PathText}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PathTooltip}" />
                                                            <TextBlock Classes="muted" FontSize="11" Text="{Binding FilesText}" />
                                                        </StackPanel>
                                                        <Grid Grid.Column="2" ColumnDefinitions="*,40" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <ProgressBar Classes="share req" Value="{Binding ShareOps}" />
                                                            <TextBlock Grid.Column="1" Classes="num muted" FontSize="10" Text="{Binding ShareOpsText}" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Grid.Column="3" Classes="num" FontSize="12" Text="{Binding OpsText}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Classes="num muted" FontSize="12" Text="{Binding BytesText}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock IsVisible="{Binding !Breakdown.Count}" Classes="muted" FontSize="12" Margin="60,4,0,0" Text="No file attribution yet — the kernel only names files opened after this app started." />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="2*" MinWidth="220">
                                <DataGridTemplateColumn.Header>
                                    <Button Classes="colhead" Tag="Name"><TextBlock Text="PROCESS" Margin="24,0,0,0" /></Button>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:ProcessRowViewModel">
                                        <DockPanel VerticalAlignment="Center">
                                            <Button DockPanel.Dock="Left" Classes="icon chevron" Margin="-6,0,4,0" PointerPressed="OnCellButtonPressed" Click="OnExpandClick" ToolTip.Tip="Show the folders this process is busy in">
                                                <Panel>
                                                    <PathIcon Data="{StaticResource IconChevronRight}" IsVisible="{Binding !IsExpanded}" />
                                                    <PathIcon Data="{StaticResource IconChevronDown}" IsVisible="{Binding IsExpanded}" />
                                                </Panel>
                                            </Button>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="10,0,0,0">
                                                <Button Classes="icon" PointerPressed="OnCellButtonPressed" Command="{Binding OpenInExplorerCommand}" ToolTip.Tip="Open the program's folder in Explorer">
                                                    <PathIcon Data="{StaticResource IconFolder}" />
                                                </Button>
                                                <Button Classes="icon" PointerPressed="OnCellButtonPressed" Command="{Binding CopyImagePathCommand}" ToolTip.Tip="Copy the program's path">
                                                    <PathIcon Data="{StaticResource IconShare}" />
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ImagePathTooltip}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.Header>
                                    <Button Classes="colhead num" Tag="Pid"><TextBlock Classes="num" Text="PID" /></Button>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:ProcessRowViewModel">
                                        <TextBlock Classes="num muted" Text="{Binding Pid}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="95">
                                <DataGridTemplateColumn.Header>
                                    <Button Classes="colhead num" Tag="Read" ToolTip.Tip="Bytes read in the window"><TextBlock Classes="num" Text="&#x2193; READ" /></Button>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:ProcessRowViewModel">
                                        <TextBlock Classes="num read-data" Text="{Binding ReadText}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="95">
                                <DataGridTemplateColumn.Header>
                                    <Button Classes="colhead num" Tag="Write" ToolTip.Tip="Bytes written in the window"><TextBlock Classes="num" Text="&#x2191; WRITE" /></Button>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:ProcessRowViewModel">
                                        <TextBlock Classes="num write-data" Text="{Binding WriteText}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.Header>
                                    <Button Classes="colhead num" Tag="Ops" ToolTip.Tip="I/O requests (read + write) in the window"><TextBlock Classes="num" Text="REQUESTS" /></Button>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:ProcessRowViewModel">
                                        <TextBlock Classes="num" Text="{Binding TotalOpsText}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip.Tip="{Binding OpsTooltip}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- SHARE: two bars per row (requests, data); the header chips pick the sort key. -->
                            <DataGridTemplateColumn Width="1.3*" MinWidth="150">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="SHARE" VerticalAlignment="Center" Margin="0,0,2,0" />
                                        <Button Classes="colhead chip req" Tag="Ops" ToolTip.Tip="Sort by requests — share of all I/O requests in the window"><TextBlock Text="REQUESTS" /></Button>
                                        <Button Classes="colhead chip data" Tag="Bytes" ToolTip.Tip="Sort by data — share of all bytes in the window"><TextBlock Text="DATA" /></Button>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:ProcessRowViewModel">
                                        <Grid ColumnDefinitions="*,40" RowDefinitions="*,*" Height="30" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding DetailTooltip}">
                                            <ProgressBar Grid.Row="0" Grid.Column="0" Classes="share req" Classes.dim="{Binding !IsOpsPrimary}" Value="{Binding ShareOps}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="num read-req" FontSize="10" Text="{Binding ShareOpsText}" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Row="1" Grid.Column="0" Classes="share data" Classes.dim="{Binding !IsBytesPrimary}" Value="{Binding ShareBytes}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="num read-data" FontSize="10" Text="{Binding ShareBytesText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="3*" MinWidth="240">
                                <DataGridTemplateColumn.Header>
                                    <Button Classes="colhead" Tag="TopFile"><TextBlock Text="TOP FILE" /></Button>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:ProcessRowViewModel">
                                        <DockPanel VerticalAlignment="Center">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="10,0,0,0">
                                                <Button Classes="icon" PointerPressed="OnCellButtonPressed" Command="{Binding OpenFileLocationCommand}" ToolTip.Tip="Show this file in Explorer">
                                                    <PathIcon Data="{StaticResource IconFolder}" />
                                                </Button>
                                                <Button Classes="icon" PointerPressed="OnCellButtonPressed" Command="{Binding CopyFilePathCommand}" ToolTip.Tip="Copy the file path">
                                                    <PathIcon Data="{StaticResource IconShare}" />
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Classes="muted" Text="{Binding TopFileText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TopFileTooltip}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock IsVisible="{Binding !HasProcesses}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding EmptyStateText}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
